/v2_work/**/*.pt
/v2_work/**/*.pkl
/v2_work/**/*.log
/v2_work/**/*.png
/v2_work/**/*.pdf
/v2_work/**/*.aux

# Paper di terzi scaricati per la ricerca dati: copyright. Il resoconto
# (literature/README.md) contiene tutto cio che ne estraiamo ed e tracciato.
/literature/papers/

# Modello FLAME: licenza MPI, mai nel repo, in nessuna copia (v2_work/genflame/official/
# e' dove il titolare della licenza mette la sua, vedi flame_model.py).
/v2_work/genflame/official/
generic_model.pkl
FLAME_masks.pkl
*FLAME*.pkl
/paper/review.md

# dati con licenza caricati dall utente (FLAME, NoW): mai versionare
/external_data/

