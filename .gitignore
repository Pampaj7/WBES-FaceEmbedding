/aau/runs/multiface_ws3a*/*.csv
/aau/runs/ws3a_hard_old/*.csv
!/aau/runs/**/summary*.csv

# Archivi scaricati da Hugging Face (dataset e snapshot del workspace, decine di GB).
/hf_downloads/

# Vendored third-party clone (upstream DiffusionNet, not our code)
/diffusion-net/

# Third-party published PDFs read for the literature report: copyrighted, the
# report itself (paper/REPORT.md) carries everything we take from them.
/paper/*.pdf
/paper/*.txt

# v2 experiment artifacts: operators, caches, checkpoints, generated meshes and logs.
