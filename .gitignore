/aau/**/*.npy
/aau/**/*.tar
/aau/**/*.pth
/aau/**/*.pt
/aau/**/*.ply
/aau/**/*.obj
# Studio umano: render e pagina ospitata (2 MB, immagini incorporate) si rigenerano.
/aau/human_study/img/
/aau/human_study/hosted/index.html

# aau/runs: 40 GB di checkpoint, viste, matrici, cache e log. Entrano solo i risultati
# leggibili: i .md e i .csv/.json piccoli (config, riepiloghi per run, tabelle).
/aau/runs/**
!/aau/runs/**/
!/aau/runs/**/*.md
!/aau/runs/**/*.csv
!/aau/runs/**/*.json
# ...ma non quelli voluminosi: ranking per checkpoint, tabelle per coppia, per epoca,
# metadati per mesh delle viste, token per mesh.
/aau/runs/**/ranking_summary.*
/aau/runs/**/pair_*.csv
/aau/runs/**/pairs_*.csv
/aau/runs/**/robustness_epoch*.json
/aau/runs/**/*__*__*.json
/aau/runs/**/size_token_*.json
